<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".gamesession.poker.PokerFragment">

    <TextView
        android:id="@+id/RecommendedAction_Label"
        android:layout_width="99dp"
        android:layout_height="38dp"
        android:text="Recommened Action:"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.849"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.757" />

    <TextView
        android:id="@+id/recommendedAction_textview"
        android:layout_width="99dp"
        android:layout_height="38dp"
        android:text="Unknown"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.849"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/RecommendedAction_Label"
        app:layout_constraintVertical_bias="0.0" />

    <Spinner
        android:id="@+id/poker_spinner_dealerCard5"
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/temporary"
        android:dropDownWidth="100dp"
        app:layout_constraintEnd_toStartOf="@+id/poker_spinner_dealerCard3"
        app:layout_constraintStart_toEndOf="@+id/poker_spinner_dealerCard2"
        app:layout_constraintTop_toBottomOf="@+id/poker_spinner_dealerCard2" />

    <Spinner
        android:id="@+id/poker_spinner_dealerCard4"
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/temporary"
        android:dropDownWidth="100dp"
        app:layout_constraintEnd_toStartOf="@+id/poker_spinner_dealerCard2"
        app:layout_constraintStart_toEndOf="@+id/poker_spinner_dealerCard1"
        app:layout_constraintTop_toBottomOf="@+id/poker_spinner_dealerCard2" />

    <Spinner
        android:id="@+id/poker_spinner_dealerCard3"
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/temporary"
        android:dropDownWidth="100dp"
        app:layout_constraintStart_toEndOf="@+id/poker_spinner_dealerCard2"
        app:layout_constraintTop_toTopOf="@+id/poker_spinner_dealerCard2" />

    <Spinner
        android:id="@+id/poker_spinner_dealerCard2"
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/temporary"
        android:dropDownWidth="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/UserHand_Label" />

    <Spinner
        android:id="@+id/poker_spinner_dealerCard1"
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/temporary"
        android:dropDownWidth="100dp"
        app:layout_constraintEnd_toStartOf="@+id/poker_spinner_dealerCard2"
        app:layout_constraintTop_toTopOf="@+id/poker_spinner_dealerCard2" />

    <TextView
        android:id="@+id/poker_Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Poker"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.022" />

    <TextView
        android:id="@+id/UserHand_Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Cards"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.074" />

    <TextView
        android:id="@+id/Bet_Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bet:"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.041"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.022" />

    <Button
        android:id="@+id/Calculate_button_poker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Calculate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/poker_spinner_dealerCard4" />

    <TextView
        android:id="@+id/Bet_textview_Poker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No Bet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.035"
        app:layout_constraintStart_toEndOf="@+id/Bet_Label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.022" />

    <Button
        android:id="@+id/Win_button_poker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Win"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/Lose_button_poker"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.931" />

    <Button
        android:id="@+id/Lose_button_poker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lose"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/Win_button_poker"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.931" />

    <TextView
        android:id="@+id/Odds_Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Odds:"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.117"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.737" />

    <TextView
        android:id="@+id/Odds_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unknown"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.124"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Odds_Label"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>