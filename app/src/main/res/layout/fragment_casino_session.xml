<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".casinosession.CasinoSessionFragment" >

    <Button
        android:id="@+id/button_casinoSession_statistics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/statistics_button_label"
        app:layout_constraintBottom_toTopOf="@+id/button_casinoSession_end_session"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.846"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_casinoSession_set_timer" />

    <Button
        android:id="@+id/button_casinoSession_set_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/set_timer_button_label"
        app:layout_constraintBottom_toTopOf="@+id/button_casinoSession_end_session"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.821"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_casinoSession_start_game"
        app:layout_constraintVertical_bias="0.25" />

    <Button
        android:id="@+id/button_casinoSession_game_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_tips_button_label"
        app:layout_constraintBottom_toTopOf="@+id/button_casinoSession_end_session"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.169"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_casinoSession_change_balance" />

    <TextView
        android:id="@+id/textview_casinoSession_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.100000024" />

    <Button
        android:id="@+id/button_casinoSession_start_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_game_button_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.308" />

    <Button
        android:id="@+id/button_casinoSession_change_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/change_balance_button_label"
        app:layout_constraintBottom_toTopOf="@+id/button_casinoSession_end_session"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.125"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_casinoSession_start_game"
        app:layout_constraintVertical_bias="0.25" />

    <Button
        android:id="@+id/button_casinoSession_end_session"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/end_session_button_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.8" />
</androidx.constraintlayout.widget.ConstraintLayout>