<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".casinosession.CasinoSessionFragment" >

    <Button
        android:id="@+id/casinoSessionFrag_button_statistics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/CasinoSessionFrag_button_statistics_label"
        app:layout_constraintBottom_toTopOf="@+id/casinoSessionFrag_button_endSession"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.846"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/casinoSessionFrag_button_setTimer" />

    <Button
        android:id="@+id/casinoSessionFrag_button_setTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/casinoSessionFrag_button_setTimer_label"
        app:layout_constraintBottom_toTopOf="@+id/casinoSessionFrag_button_endSession"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.821"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/casinoSessionFrag_button_startGame"
        app:layout_constraintVertical_bias="0.25" />

    <Button
        android:id="@+id/casinoSessionFrag_button_gameTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/casinoSessionFrag_button_gameTips_label"
        app:layout_constraintBottom_toTopOf="@+id/casinoSessionFrag_button_endSession"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.169"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/casinoSessionFrag_button_changeBalance" />

    <TextView
        android:id="@+id/casinoSessionFrag_textview_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.100000024" />

    <Button
        android:id="@+id/casinoSessionFrag_button_startGame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/casinoSessionFrag_button_startGame_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.308" />

    <Button
        android:id="@+id/casinoSessionFrag_button_changeBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/casinoSessionFrag_button_changeBalance_label"
        app:layout_constraintBottom_toTopOf="@+id/casinoSessionFrag_button_endSession"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.125"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/casinoSessionFrag_button_startGame"
        app:layout_constraintVertical_bias="0.25" />

    <Button
        android:id="@+id/casinoSessionFrag_button_endSession"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/casinoSessionFrag_button_endSession_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.8" />

</androidx.constraintlayout.widget.ConstraintLayout>