<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.honeybadger.gamblingbadger.HomeFragment"
        android:label="@string/homeFrag_label"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_startSessionFragment"
            app:destination="@id/startSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/startSessionFragment"
        android:name="com.honeybadger.gamblingbadger.casinosession.StartSessionFragment"
        android:label="@string/startSessionFrag_label"
        tools:layout="@layout/fragment_start_session">

        <action
            android:id="@+id/action_startSessionFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_startSessionFragment_to_inSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/casinoSessionFragment"
        android:name="com.honeybadger.gamblingbadger.casinosession.CasinoSessionFragment"
        android:label="@string/casinoSessionFrag_label"
        tools:layout="@layout/fragment_casino_session" >
        <action
            android:id="@+id/action_casinoSessionFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_casinoSessionFragment_to_startGameFragment"
            app:destination="@id/startGameFragment" />
        <action
            android:id="@+id/action_casinoSessionFragment_to_timerFragment"
            app:destination="@id/timerFragment" />
    </fragment>
    <fragment
        android:id="@+id/startGameFragment"
        android:name="com.honeybadger.gamblingbadger.gamesession.StartGameFragment"
        android:label="@string/startGameFrag_label"
        tools:layout="@layout/fragment_start_game" >
        <action
            android:id="@+id/action_startGameFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/timerFragment"
        android:name="com.honeybadger.gamblingbadger.timer.TimerFragment"
        android:label="fragment_timer"
        tools:layout="@layout/fragment_timer" >
        <action
            android:id="@+id/action_timerFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
</navigation>