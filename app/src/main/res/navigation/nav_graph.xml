<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.honeybadger.gamblingbadger.HomeFragment"
        android:label="@string/homeFrag_label"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_startSessionFragment"
            app:destination="@id/startSessionFragment" />

        <action
            android:id="@+id/action_homeFragment_to_tipFragment"
            app:destination="@id/tipsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_generalStatisticsFragment"
            app:destination="@id/generalStatisticsFragment" />
    </fragment>


    <fragment
        android:id="@+id/startSessionFragment"
        android:name="com.honeybadger.gamblingbadger.casinosession.StartSessionFragment"
        android:label="@string/startSessionFrag_label"
        tools:layout="@layout/fragment_start_session">

        <action
            android:id="@+id/action_startSessionFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_startSessionFragment_to_inSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/casinoSessionFragment"
        android:name="com.honeybadger.gamblingbadger.casinosession.CasinoSessionFragment"
        android:label="@string/casinoSessionFrag_label"
        tools:layout="@layout/fragment_casino_session" >
        <action
            android:id="@+id/action_casinoSessionFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_casinoSessionFragment_to_startGameFragment"
            app:destination="@id/startGameFragment" />
        <action
            android:id="@+id/action_casinoSessionFragment_to_timerFragment"
            app:destination="@id/timerFragment" />
        <action
            android:id="@+id/action_casinoSessionFragment_to_tipsFragment"
            app:destination="@id/tipsFragment" />
        <action
            android:id="@+id/action_casinoSessionFragment_to_casinoStatisticsFragment"
            app:destination="@id/casinoStatisticsFragment" />
        <action
            android:id="@+id/action_casinoSessionFragment_to_changeBalanceFragment"
            app:destination="@id/changeBalanceFragment" />
    </fragment>
    <fragment
        android:id="@+id/startGameFragment"
        android:name="com.honeybadger.gamblingbadger.gamesession.StartGameFragment"
        android:label="@string/startGameFrag_label"
        tools:layout="@layout/fragment_start_game" >
        <action
            android:id="@+id/action_startGameFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
        <action
            android:id="@+id/action_startGameFragment_to_blackjackFragment"
            app:destination="@id/blackjackFragment" />
        <action
            android:id="@+id/action_startGameFragment_to_pokerFragment"
            app:destination="@id/pokerFragment" />
        <action
            android:id="@+id/action_startGameFragment_to_rouletteFragment"
            app:destination="@id/rouletteFragment" />
        <action
            android:id="@+id/action_startGameFragment_to_texasHoldemFragment"
            app:destination="@id/texasHoldemFragment" />
    </fragment>
    <fragment
        android:id="@+id/timerFragment"
        android:name="com.honeybadger.gamblingbadger.timer.TimerFragment"
        android:label="fragment_timer"
        tools:layout="@layout/fragment_timer" >
        <action
            android:id="@+id/action_timerFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/blackjackFragment"
        android:name="com.honeybadger.gamblingbadger.gamesession.blackjack.BlackjackFragment"
        android:label="fragment_blackjack"
        tools:layout="@layout/fragment_blackjack" >
        <action
            android:id="@+id/action_blackjackFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
        <action
            android:id="@+id/action_blackjackFragment_to_bjtipsFragment"
            app:destination="@id/bjtipsFragment" />
    </fragment>
    <fragment
        android:id="@+id/pokerFragment"
        android:name="com.honeybadger.gamblingbadger.gamesession.poker.PokerFragment"
        android:label="fragment_poker"
        tools:layout="@layout/fragment_poker" >
        <action
            android:id="@+id/action_pokerFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/rouletteFragment"
        android:name="com.honeybadger.gamblingbadger.gamesession.roulette.RouletteFragment"
        android:label="fragment_roulette"
        tools:layout="@layout/fragment_roulette" >
        <action
            android:id="@+id/action_rouletteFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/texasHoldemFragment"
        android:name="com.honeybadger.gamblingbadger.gamesession.texasholdem.TexasHoldemFragment"
        android:label="fragment_texas_holdem"
        tools:layout="@layout/fragment_texas_holdem" >
        <action
            android:id="@+id/action_texasHoldemFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>

    <fragment
        android:id="@+id/tipsFragment"
        android:name="com.honeybadger.gamblingbadger.tips.TipsFragment"
        android:label="Tips and Tricks"
        tools:layout="@layout/fragment_tips" >
        <action
            android:id="@+id/action_tipsFragment_to_bjtipsFragment"
            app:destination="@id/bjtipsFragment" />
        <action
            android:id="@+id/action_tipsFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_tipsFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>

    <fragment
        android:id="@+id/bjtipsFragment"
        android:name="com.honeybadger.gamblingbadger.tips.BJTipFrag"
        android:label="Blackjack Tips"
        tools:layout = "@layout/fragment_b_j_tip">
        <action
            android:id="@+id/action_bjtipsFragment_to_tipsFragment"
            app:destination="@id/tipsFragment" />
        <action
            android:id="@+id/action_bjtipsFragment_to_blackjackFragment"
            app:destination="@id/blackjackFragment" />
    </fragment>
    <fragment
        android:id="@+id/generalStatisticsFragment"
        android:name="com.honeybadger.gamblingbadger.statistics.GeneralStatisticsFragment"
        android:label="fragment_general_statistics"
        tools:layout="@layout/fragment_general_statistics" >
        <action
            android:id="@+id/action_generalStatisticsFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_generalStatisticsFragment_to_generalGameStatisticsFragment"
            app:destination="@id/generalGameStatisticsFragment" />
        <action
            android:id="@+id/action_generalStatisticsFragment_to_specificGameStatisticsFragment"
            app:destination="@id/specificGameStatisticsFragment" />
        <action
            android:id="@+id/action_generalStatisticsFragment_to_casinoStatisticsFragment"
            app:destination="@id/casinoStatisticsFragment" />
        <action
            android:id="@+id/action_generalStatisticsFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/casinoStatisticsFragment"
        android:name="com.honeybadger.gamblingbadger.statistics.CasinoStatisticsFragment"
        android:label="fragment_casino_statistics"
        tools:layout="@layout/fragment_casino_statistics" >
        <action
            android:id="@+id/action_casinoStatisticsFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
        <action
            android:id="@+id/action_casinoStatisticsFragment_to_generalStatisticsFragment"
            app:destination="@id/generalStatisticsFragment" />
        <action
            android:id="@+id/action_casinoStatisticsFragment_to_generalGameStatisticsFragment"
            app:destination="@id/generalGameStatisticsFragment" />
        <action
            android:id="@+id/action_casinoStatisticsFragment_to_specificGameStatisticsFragment"
            app:destination="@id/specificGameStatisticsFragment" />
        <action
            android:id="@+id/action_casinoStatisticsFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/generalGameStatisticsFragment"
        android:name="com.honeybadger.gamblingbadger.statistics.GeneralGameStatisticsFragment"
        android:label="fragment_general_game_statistics"
        tools:layout="@layout/fragment_general_game_statistics" >
        <action
            android:id="@+id/action_generalGameStatisticsFragment_to_generalStatisticsFragment"
            app:destination="@id/generalStatisticsFragment" />
        <action
            android:id="@+id/action_generalGameStatisticsFragment_to_casinoStatisticsFragment"
            app:destination="@id/casinoStatisticsFragment" />
        <action
            android:id="@+id/action_generalGameStatisticsFragment_to_specificGameStatisticsFragment"
            app:destination="@id/specificGameStatisticsFragment" />
        <action
            android:id="@+id/action_generalGameStatisticsFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_generalGameStatisticsFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/specificGameStatisticsFragment"
        android:name="com.honeybadger.gamblingbadger.statistics.SpecificGameStatisticsFragment"
        android:label="fragment_specific_game_statistics"
        tools:layout="@layout/fragment_specific_game_statistics" >
        <action
            android:id="@+id/action_specificGameStatisticsFragment_to_generalGameStatisticsFragment"
            app:destination="@id/generalGameStatisticsFragment" />
        <action
            android:id="@+id/action_specificGameStatisticsFragment_to_generalStatisticsFragment"
            app:destination="@id/generalStatisticsFragment" />
        <action
            android:id="@+id/action_specificGameStatisticsFragment_to_casinoStatisticsFragment"
            app:destination="@id/casinoStatisticsFragment" />
        <action
            android:id="@+id/action_specificGameStatisticsFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_specificGameStatisticsFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/changeBalanceFragment"
        android:name="com.honeybadger.gamblingbadger.balance.ChangeBalanceFragment"
        android:label="fragment_change_balance"
        tools:layout="@layout/fragment_change_balance" >
        <action
            android:id="@+id/action_changeBalanceFragment_to_addBalanceFragment"
            app:destination="@id/addBalanceFragment" />
        <action
            android:id="@+id/action_changeBalanceFragment_to_subBalanceFragment"
            app:destination="@id/subBalanceFragment" />
        <action
            android:id="@+id/action_changeBalanceFragment_to_casinoSessionFragment"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/addBalanceFragment"
        android:name="com.honeybadger.gamblingbadger.balance.AddBalanceFragment"
        android:label="fragment_add_balance"
        tools:layout="@layout/fragment_add_balance" >
        <action
            android:id="@+id/action_addBalanceFragment_to_changeBalanceFragment"
            app:destination="@id/changeBalanceFragment" />
        <action
            android:id="@+id/action_addBalanceFragment_to_casinoSessionFragment2"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
    <fragment
        android:id="@+id/subBalanceFragment"
        android:name="com.honeybadger.gamblingbadger.balance.SubBalanceFragment"
        android:label="fragment_sub_balance"
        tools:layout="@layout/fragment_sub_balance" >
        <action
            android:id="@+id/action_subBalanceFragment_to_changeBalanceFragment"
            app:destination="@id/changeBalanceFragment" />
        <action
            android:id="@+id/action_subBalanceFragment_to_casinoSessionFragment2"
            app:destination="@id/casinoSessionFragment" />
    </fragment>
</navigation>